{
  "name": "dsh-soul",
  "version": "0.1.0",
  "publishConfig": { "access": "public" },
  "scripts": {
    "test": "node --unhandled-rejections=strict --test identity.test.mjs runtime.test.mjs",
    "verify": "node verify.mjs"
  },
  "engines": { "node": ">=22.13.0" },
  "description": "ds 自己的记忆：以「经历」为单位，默认衰减，入口判据是行为痕迹而不是自我评价。不是 RAG，不是档案。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "THIRD-PARTY-NOTICES.md",
    "LICENSE-DETAILS.md"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "license": "MIT"
}
